  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "20 · BLUK visuals (2D fog & parallax)"
  description: "2D atmosphere from BLUK: sprites are tinted towards the sky colour by their distance to the camera (plus a vertical gradient), and ParallaxingScript moves the camera's child layers by an amount based on their depth, which fakes parallax with an orthographic camera. SkyColorManager keeps the camera background and the fog colour in sync."
  controls: "A / D or arrow keys: move the camera (it drifts on its own when idle)\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
