  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "41 · VFX master shader (part 2)"
  description: "Part 2 adds a secondary texture, colour banding, polar coordinates, a circle mask, a cull-mode enum and - most importantly - uses the vertex colour alpha to increase the cutoff, so particle systems can dissolve particles over their lifetime. (DemoProceduralMesh gives the meshes explicit white vertex colours.)"
  controls: "Press Play to see the particles\nRight mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
