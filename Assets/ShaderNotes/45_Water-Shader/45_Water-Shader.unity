  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "45 · Water shader"
  description: "A transparent, tessellated surface shader: two noise textures displace the vertices (normals are rebuilt from two neighbour samples), the wave height indexes a gradient map, and the depth texture gives shore colour, foam lines and soft transparency near the sand. On the right: the older NormalDisplacement water material."
  controls: "Right mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
