  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "28 · Unlit waterfall"
  description: "Three unlit shaders: the waterfall uses a scrolling, posterised noise (round(noise * 5) / 5) to blend two vertical gradients, plus a foam line at the bottom; the pool compares the scene depth with its own depth to draw white foam where it intersects objects; the foam particles use a two-sided dissolve driven by the particle colour alpha (two passes: front colour and back colour with Cull Front)."
  controls: "Press Play to see the foam particles\nRight mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
