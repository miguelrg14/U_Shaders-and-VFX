  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "46 · Geometry shaders"
  description: "Introduction to geometry shaders: NewGeometryShader just re-emits each triangle (the template), and TrianglePyramidExtrusion turns every triangle into a pyramid by adding a vertex at the barycentre pushed along the normal (black at the base, white at the tip)."
  controls: "Space: pause the extrusion animation\nRight mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
