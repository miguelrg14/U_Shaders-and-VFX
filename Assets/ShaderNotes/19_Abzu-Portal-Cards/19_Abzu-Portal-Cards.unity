  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "19 · ABZÛ portal cards"
  description: "Transparent 'light cards' like the ones in ABZÛ: their alpha depends on the distance to the camera, so they fade away as you get close instead of popping through the camera. A sine falloff on U and V softens the quad edges. Zoom towards a card to see it fade."
  controls: "Right mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
