  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "52 · Sky shader"
  description: "A procedural skybox shader: three-colour vertical gradient, sun and moon (with phase) placed with _WorldSpaceLightPos0, stars that only show at night, and panning clouds with silver lining. SkyController.cs evaluates gradients from the sun's angle to drive the sky, sun, light, ambient and cloud colours - the directional light rotates to play a full day/night cycle.\nTip: enable 'Use Srub' on the light to scrub the cycle from the inspector."
  controls: "Right mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
