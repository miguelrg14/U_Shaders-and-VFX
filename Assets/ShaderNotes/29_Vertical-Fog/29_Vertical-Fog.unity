  m_Script: {fileID: 11500000, guid: da12d498ed349351d5973a998a602df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "29 · Vertical fog (intersection)"
  description: "A transparent plane whose opacity grows with the distance between its own depth and the scene depth behind it (smootherstep of the intersection). Where the ground is far below, the plane is opaque, so valleys fill with fog while hill tops poke through. The plane moves up and down slowly."
  controls: "Right mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
