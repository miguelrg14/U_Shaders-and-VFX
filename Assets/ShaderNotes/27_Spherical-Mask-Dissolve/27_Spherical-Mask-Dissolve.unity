  m_Name: 
  m_EditorClassIdentifier: 
  title: "27 · Spherical mask dissolve"
  description: "SphereMaskController sends a global position/radius/softness (Shader.SetGlobal...) and every material with SphericalMaskDissolve clips the pixels outside that sphere, with an emissive noisy edge. Works in edit mode too: move the small sphere in the Scene view."
  controls: "Right mouse drag: orbit · Wheel: zoom · Middle mouse drag: pan\nN / B: next / previous demo · M: menu · H: hide this panel"
  showPanel: 1
